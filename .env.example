# Example environment variables for FlightWatch
# Copy this to .env for local testing and DO NOT commit the .env file.

# SerpApi key (required)
SERPAPI_KEY=your_serpapi_key_here

# ntfy topic to push notifications to (optional if using Actions secrets).
# Treat this like a password: anyone who knows it can read your alerts and
# push notifications to your phone. Use a long random string.
NTFY_TOPIC=replace-with-your-own-random-topic

# Optional overrides
STATE_FILE=state.json
HOME_AIRPORT=AVV
AWAY_AIRPORT=SYD
TIMEZONE=Australia/Melbourne
DEPART_AHEAD=1
MAX_NIGHTS=2
MIN_LEAD_HOURS=1
CHECKIN_CLOSES_MIN=40
DRIVE_MIN=25
